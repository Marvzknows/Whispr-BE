PORT=4000
NODE_ENV=development

# Must match the credentials in docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auth_template"

# Generate your own: node -p "require('node:crypto').randomBytes(48).toString('hex')"
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string"

# The frontend origin allowed by CORS (no trailing slash)
CLIENT_ORIGIN="http://localhost:3000"